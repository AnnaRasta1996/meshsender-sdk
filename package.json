{
  "name": "@meshsender/sdk",
  "version": "0.1.0-hackathon",
  "description": "MeshSender Open SDK — Hackathon Flagship Edition (public-safe modules)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "playground",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "PUBLICATION_ALLOWLIST.md",
    "FEATURE_READINESS.md",
    "DISCLOSURE_REVIEW.md",
    ".github/workflows/pages.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:browser",
    "build:browser": "node scripts/build-browser.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/sdk.core.test.ts tests/sdk.u92f2.test.ts tests/sdk.u92f3.test.ts tests/sdk.u92f4.test.ts tests/sdk.u92f5.test.ts tests/sdk.u92f6.test.ts tests/sdk.u92f7.test.ts tests/sdk.u92f7f1.test.ts",
    "bundle:startup": "node scripts/bundle-startup-check.mjs",
    "demo": "node --import tsx scripts/demo.ts",
    "playground:serve": "npm run build:browser && node scripts/serve-playground.mjs",
    "playground:interact": "node --import tsx scripts/playground-interact.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "@solana/web3.js": "^1.98.4",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
